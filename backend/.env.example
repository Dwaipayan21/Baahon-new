# ========================================
# BAAHON BACKEND ENVIRONMENT CONFIGURATION
# ========================================

# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/baahon

# Geoapify Places API Key
# (Server-side only — never expose to frontend/client bundles)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
